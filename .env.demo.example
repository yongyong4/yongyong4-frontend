# 시연용 설정 (로컬 데모 BE + 가상 시계)
# 이 파일을 .env.local로 복사해서 쓰기:  cp .env.demo.example .env.local
# .env.local은 .env보다 우선 적용되고 git에 올라가지 않음. 시연이 끝나면 .env.local을 지우면 됨

# /api 요청을 개발 서버(vite proxy)가 로컬 데모 BE로 넘김
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# (급할 때만) 경로 탐색만 배포 서버로 보내기. 로컬 데모 BE에서 경로 탐색(ODsay)이 실패하면 주석(#)을 지우기
# 나머지(분석·전략·이동·가상 시계)는 위의 로컬 데모 BE를 그대로 씀
# VITE_ROUTE_SEARCH_PROXY_TARGET=https://yongyong4.duckdns.org

# trips API도 목 데이터 대신 실제(데모) BE를 씀
VITE_USE_MOCK=false

# 가상 시계 사용: GET /api/v1/demo/clock의 virtualNow를 앱의 "지금"으로 씀
VITE_DEMO_MODE=true

# 카카오맵 JavaScript 키 (브라우저에 공개되는 키. http://localhost:5173에서만 지도가 뜸)
VITE_KAKAO_MAP_KEY=bc17c82ed19f6d9692158b26104e3381
