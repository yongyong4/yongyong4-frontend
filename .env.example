# API 요청 기본 경로. 개발 중에는 /api로 두면 vite proxy가 BE로 넘겨줌
VITE_API_BASE_URL=/api

# trips API 목 데이터 사용 여부. 비워두면 개발 서버에서는 목, 배포에서는 실제 API
# BE 연동을 확인할 때만 false로 바꾸기
# VITE_USE_MOCK=false

# 개발 서버 proxy 대상 (BE 로컬 주소)
# 배포된 BE를 쓰려면 https://yongyong4.duckdns.org
VITE_API_PROXY_TARGET=http://localhost:8080

# 카카오맵 JavaScript 키 (카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키)
# 카카오 디벨로퍼스 [플랫폼 > Web]에 등록한 도메인에서만 지도가 뜸 (예: http://localhost:5173)
VITE_KAKAO_MAP_KEY=
